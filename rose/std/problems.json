{
 "about": "Curated problem classes for specification matching (rose/spec.py). Own work, MIT. Facets are a controlled vocabulary (regular expressions, English + German); refs in 'see' and 'solvers' must exist in the knowledge (tests/test_spec.py).",
 "facets": {
  "E_graph": "\\b(graph|network|nodes?|vertices|edges?|road network|roads?|streets?|netzwerk|knoten|kanten|stra(ß|ss)ennetz|stra(ß|ss)en)\\b",
  "E_locations": "\\b(cities|city|customers?|locations?|stops|addresses|depot|towns?|places|buildings?|sites|st(ä|a)dte|stadt|kunden|orte|haltestellen|adressen|standorte|geb(ä|a)ude)\\b",
  "E_items": "\\b(items?|objects|packages|parcels|goods|rucksack|knapsack|backpack|gegenst(ä|a)nde|pakete|artikel|waren|rucksack)\\b",
  "E_bins": "\\b(bins?|containers?|boxes|crates|pallets|beh(ä|a)lter|kisten|paletten)\\b",
  "E_jobs": "\\b(jobs?|tasks|machines?|exams?|lectures|operations|auftr(ä|a)ge|maschinen|pr(ü|u)fungen|vorlesungen)\\b",
  "E_sequence": "\\b(list|array|numbers|sequence|values|liste|zahlen|folge|werte)\\b",
  "E_strings": "\\b(words?|strings?|text|characters?|letters|wort|w(ö|o)rter|zeichenkette|buchstaben)\\b",
  "E_points": "\\b(points|coordinates|punkte|koordinaten)\\b",
  "R_weights": "\\b(distances?|length|cost|costs|travel times?|kilometres|km|entfernung(en)?|strecke|gesamtstrecke|distanz(en)?|kosten|fahrzeit(en)?|l(ä|a)nge|kabell(ä|a)nge)\\b",
  "R_capacity": "\\b(capacity|capacities|weight limit|limit of|at most|maximum load|tonnes|tons|kapazit(ä|a)t|gewichtsgrenze|h(ö|o)chstens|zuladung|ladekapazit(ä|a)t)\\b",
  "R_value": "\\b(value|values|profit|worth|benefit|wert|gewinn|nutzen)\\b",
  "R_precedence": "\\b(must (be done|come|happen) before|depends on|dependencies|prerequisites?|abh(ä|a)ngig(keit(en)?)?|voraussetzung(en)?)\\b",
  "R_conflict": "(same time|at once|conflicts?|clash(es)?|adjacent|neighbouring|neighboring|gleichzeitig|konflikt(e)?|benachbart)",
  "R_target_sum": "\\b(sums? (up )?to exactly|add(s)? up to|exactly \\d+|genau \\d+ ergeben|summe von genau)\\b",
  "O_tour": "\\b(tour|tours|round[ -]?trip|rundreise|rundtour|rundfahrt|tourplanung|touren)\\b|\\breturns? to\\b|\\bback to\\b|zur(ü|u)ck",
  "O_path": "\\b(route|path|way|weg|pfad|verbindung)\\b",
  "O_tree": "\\b(connect(ed|s)?|spanning|tree|verbinden|verbunden|vernetzen|baum)\\b",
  "O_order": "\\b(sort|sorting|sorted|order|ordering|rank|sortier\\w*|reihenfolge|ordnen)\\b",
  "O_subset": "\\b(choose|select|pick|subset|which (items|objects)|ausw(ä|a)hlen|auswahl|w(ä|a)hle)\\b",
  "O_assignment": "\\b(assign\\w*|allocat\\w*|match (each|every)|pair (each|every)|zuordn\\w*|zuweis\\w*|zuteil\\w*)\\b",
  "O_coloring": "\\b(colou?r\\w*|time ?slots?|slots|f(ä|a)rb\\w*|zeitslots?)\\b",
  "O_schedule": "\\b(schedul\\w*|timetable|makespan|zeitplan|stundenplan|ablaufplan)\\b",
  "O_flow": "\\b(flow|throughput|pipes|pipelines?|durchfluss|durchsatz|fluss)\\b",
  "O_hull": "\\b(convex hull|enclos\\w*|fence around|konvexe h(ü|u)lle|umschlie(ß|ss)\\w*)\\b",
  "O_edit": "\\b(edits?|insertions?|deletions?|substitutions?|editierdistanz|(ä|a)nderungen)\\b|turn one \\w+ into|transform \\w+ into",
  "O_common": "\\b(common subsequence|in common|gemeinsame teilfolge)\\b",
  "O_cover": "\\b(cover\\w*|abdeck\\w*|(ü|u)berdeck\\w*)\\b",
  "O_search": "\\b(look up|search for|find the position|binary search|in a sorted|position von|suchen)\\b",
  "J_min": "\\b(shortest|cheapest|minimal|minimum|minimi[sz]e\\w*|least|fewest|as few|as short|smallest|lowest|fastest|k(ü|u)rzest\\w*|g(ü|u)nstigst\\w*|minimier\\w*|wenigst\\w*|m(ö|o)glichst (wenig|kurz)|schnellst\\w*|kleinst\\w*)\\b",
  "J_max": "\\b(maximi[sz]e\\w*|maximum|most|largest|highest|maximal|maximier\\w*|gr(ö|o)(ß|ss)t\\w*|h(ö|o)chst\\w*|meist\\w*|m(ö|o)glichst viel)\\b",
  "C_visit_all": "\\b(visit(s|ing)?|besuch\\w*|anfahr\\w*|deliver(s|ing)? to|beliefer\\w*) (all|every|each|\\d+|alle|jede\\w*|s(ä|a)mtliche)\\b|\\b(all|every|alle) (cities|customers|locations|stops|st(ä|a)dte|kunden|orte)\\b",
  "C_return": "\\breturns? to\\b|\\bback to\\b|\\bround[ -]?trip\\b|\\bdepot\\b|zur(ü|u)ck|rundreise",
  "C_multi_vehicle": "\\b(\\d+|two|three|four|five|six|several|multiple|mehrere|zwei|drei|vier|f(ü|u)nf) (trucks|vehicles|vans|lorries|fahrzeuge|lkw|transporter|lieferwagen)\\b|\\b(fleet|flotte)\\b",
  "C_every_edge": "\\b(drive|driving|walk|traverse|sweep|clear|plough|plow|inspect|fahr\\w*|abfahr\\w*|kehr\\w*|r(ä|a)um\\w*|kontrollier\\w*)\\b[^.]{0,30}\\b((along|through|over|down) )?(every|each|all|jede|alle)( \\w+)? (streets?|roads?|edges?|lanes?|stra(ß|ss)en?|kanten?)\\b",
  "C_connect_all": "\\b(every|each|all) \\w+ (is |are )?connected\\b|\\bconnect (all|every|\\d+)\\b|\\balle \\w+ (sind )?verbunden\\b|\\bverbinde\\w* alle\\b",
  "C_source_target": "\\bfrom [A-ZÄÖÜa-zäöü]\\w* to [A-ZÄÖÜa-zäöü]\\w*|\\bvon \\w+ nach \\w+|\\bbetween two\\b",
  "C_pairs_all": "\\b(all pairs|every pair|each pair|between all|distance table|allen paaren|entfernungstabelle)\\b",
  "C_time_windows": "\\b(time windows?|zeitfenster)\\b",
  "O_lp": "\\b(linear program\\w*|linear constraints|linear objective|lineare optimierung|lineares programm)\\b",
  "O_root": "\\b(roots? of|zeros? of|solve the equation|equals zero|nullstellen?|gleichung l(ö|o)sen)\\b"
