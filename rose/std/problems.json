 "problems": [
  {
   "id": "travelling_salesperson",
   "name": "travelling salesperson problem (TSP)",
   "description": "visit every location exactly once and return to the start with minimum total distance; one vehicle, no capacity",
   "aliases": [
    "travelling salesman problem",
    "traveling salesman",
    "round trip",
    "tour planning with one vehicle",
    "Tourplanung",
    "Rundreiseproblem"
   ],
   "requires": [
    [
     "E_locations",
     "E_graph"
    ],
    [
     "O_tour",
     "C_return"
    ],
    [
     "J_min"
    ],
    [
     "C_visit_all",
     "O_tour"
    ]
   ],
   "optional": [
    "R_weights",
    "C_visit_all",
    "C_return"
   ],
   "forbids": [
    "C_multi_vehicle",
    "R_capacity",
    "C_every_edge"
   ],
   "complexity": "NP-hard",
   "solvers": [
    {
     "name": "Held-Karp dynamic programming",
     "ref": "algo:heldkarp_algorithm",
     "use": "exact, O(n^2 2^n), up to about 20 locations"
    },
    {
     "name": "nearest neighbour",
     "ref": "algo:nearest_neighbour_algorithm",
     "use": "construction heuristic, O(n^2)"
    },
    {
     "name": "2-opt",
     "ref": "algo:n2_opt",
     "use": "local improvement of any tour"
    },
    {
     "name": "Christofides",
     "ref": "algo:christofides_algorithm",
     "use": "metric distances: at most 1.5 x optimum"
    }
   ],
   "see": [
    "algo:travelling_salesperson_problem"
   ]
  },
