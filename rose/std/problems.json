 "problems": [
  {
   "id": "travelling_salesperson",
   "name": "travelling salesperson problem (TSP)",
   "description": "visit every location exactly once and return to the start with minimum total distance; one vehicle, no capacity",
   "aliases": [
    "travelling salesman problem",
    "traveling salesman",
    "round trip",
    "tour planning with one vehicle",
    "Tourplanung",
    "Rundreiseproblem"
