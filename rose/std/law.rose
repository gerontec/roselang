  var omega: Real[Hz]
  eq  Wo = R * sqrt(omega / nu)
  ref wikidata:Q2066584
end


law youngs_modulus
  intent "Young's modulus"
  var E: Real[Pa]
  var sigma: Real[Pa]
  var varepsilon: Real
  eq  E = sigma / varepsilon
  ref wikidata:Q2091584
end

